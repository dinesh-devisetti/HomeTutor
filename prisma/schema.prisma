generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

enum Role {
  PARENT
  STUDENT
  TUTOR
  ADMIN
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum TutoringMode {
  ONLINE
  IN_HOME
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  parent        Parent?
  tutor         Tutor?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

model Parent {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  fullName   String
  addressEnc Bytes?
  students        Student[]
  bookings        Booking[]
  reviews         Review[]

  @@map("parents")
}

model Student {
  id          String    @id @default(cuid())
  fullName    String
  dateOfBirth DateTime  @db.Date
  gradeLevel  String
  guardianId  String?
  guardian    Parent?   @relation(fields: [guardianId], references: [id])
  userId      String?   @unique
  bookings    Booking[]

  @@map("students")
}

model Tutor {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  fullName           String
  bio                String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  phoneEnc           Bytes?
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  subjects        TutorSubject[]
  availability    Availability[]
  documents       VerificationDoc[]
  bookings        Booking[]
  reviews         Review[]

  @@map("tutors")
}

model TutorSubject {
  id               String       @id @default(cuid())
  tutorId          String
  tutor            Tutor        @relation(fields: [tutorId], references: [id])
  subject          String
  gradeLevel       String
  ratePaisePerHour Int
  mode             TutoringMode

  @@index([tutorId])
  @@index([subject, gradeLevel, mode])
  @@map("tutor_subjects")
}

model Availability {
  id        String @id @default(cuid())
  tutorId   String
  tutor     Tutor  @relation(fields: [tutorId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([tutorId])
  @@map("availabilities")
}

model VerificationDoc {
  id         String   @id @default(cuid())
  tutorId    String
  tutor      Tutor    @relation(fields: [tutorId], references: [id])
  docType    String
  storageKey String
  uploadedAt DateTime @default(now()) @db.Timestamptz

  @@map("verification_docs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Booking {
  id           String        @id @default(cuid())
  parentId     String
  parent       Parent        @relation(fields: [parentId], references: [id])
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  tutorId      String
  tutor        Tutor         @relation(fields: [tutorId], references: [id])
  subject      String
  mode         TutoringMode
  status       BookingStatus @default(REQUESTED)
  startTime    DateTime      @db.Timestamptz
  endTime      DateTime      @db.Timestamptz
  pricePaise   Int
  currency     String        @default("INR")
  cancelReason String?
  completedAt  DateTime?     @db.Timestamptz
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  messages       Message[]
  review         Review?

  @@index([tutorId, startTime])
  @@map("bookings")
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([bookingId, createdAt])
  @@map("messages")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  tutorId   String
  tutor     Tutor    @relation(fields: [tutorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("reviews")
}

